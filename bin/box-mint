#!/usr/bin/env bash
# box-mint NAME: print one GitHub App installation token for the repos in box-repos/NAME.json ({"repos":["owner/name"]}).
# Stdout is the token and nothing else; diagnostics and expires_at=<iso8601> go to stderr. BOX_CONFIG_DIR overrides ~/.config/agent-boxes.
# The JWT and token only ever travel through shell variables and curl's stdin (-H @-), never argv or files.
set -euo pipefail

die() { echo "box-mint: $*" >&2; exit 1; }

cfg="${BOX_CONFIG_DIR:-$HOME/.config/agent-boxes}"
name="${1:-}"
[[ "$name" =~ ^[a-z][a-z0-9-]*$ ]] || die "usage: box-mint NAME (lowercase letters, digits, dashes)"
reg="$cfg/box-repos/$name.json"
[ -r "$reg" ] || die "missing registry file $reg"
[ -r "$cfg/app.conf" ] && [ -r "$cfg/app.pem" ] || die "missing $cfg/app.conf or app.pem"
for t in curl jq openssl; do command -v "$t" >/dev/null || die "$t not found"; done

# Repos must be owner/name, all with one owner; the API wants bare names.
jq -e '(.repos | type == "array" and length > 0 and all(type == "string" and test("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")))
  and ([.repos[] | split("/")[0]] | unique | length == 1)' "$reg" >/dev/null \
  || die "$reg must list at least one owner/name repo, all with the same owner"
body="$(jq -c '{repositories: [.repos[] | split("/")[1]], permissions: {contents: "write", pull_requests: "write"}}' "$reg")"

CLIENT_ID="" INSTALLATION_ID=""
# shellcheck disable=SC1090,SC1091
. "$cfg/app.conf"
[ -n "$CLIENT_ID" ] && [ -n "$INSTALLATION_ID" ] || die "$cfg/app.conf must set CLIENT_ID and INSTALLATION_ID"
[[ "$INSTALLATION_ID" =~ ^[0-9]+$ ]] || die "INSTALLATION_ID must be numeric"

b64() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
now=$(date +%s)
h=$(printf '{"alg":"RS256","typ":"JWT"}' | b64)
p=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$CLIENT_ID" | b64)
s=$(printf '%s.%s' "$h" "$p" | openssl dgst -sha256 -sign "$cfg/app.pem" | b64) || die "could not sign the JWT"
[ -n "$s" ] || die "could not sign the JWT"

out="$(printf 'Authorization: Bearer %s.%s.%s\n' "$h" "$p" "$s" | curl -sS -m 20 -H @- \
  -H 'Accept: application/vnd.github+json' -X POST -d "$body" -w '\n%{http_code}' \
  "https://api.github.com/app/installations/$INSTALLATION_ID/access_tokens")" || die "request to GitHub failed"
code="${out##*$'\n'}"; json="${out%$'\n'*}"
[ "$code" = 201 ] || die "mint failed: HTTP $code: $(jq -r '.message // empty' <<<"$json" 2>/dev/null | head -c 200)"
tok="$(jq -r '.token // empty' <<<"$json")"
[[ "$tok" == ghs_* ]] || die "response held no ghs_ token"
echo "expires_at=$(jq -r '.expires_at' <<<"$json")" >&2
printf '%s\n' "$tok"
