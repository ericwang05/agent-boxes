#!/usr/bin/env bash
# box-note "<task>" <working|done|needs-you|blocked>: append one status line (time, state, commit, task) to ~/.box/status.log.
set -euo pipefail
[ "$#" = 2 ] || { echo 'usage: box-note "<task>" <working|done|needs-you|blocked>' >&2; exit 1; }
task="$1" state="$2"
case "$state" in working | done | needs-you | blocked) ;; *) echo "box-note: bad state: $state" >&2; exit 1 ;; esac
task="$(printf '%s' "$task" | tr -c '[:alnum:] ._,:;/#@()+=-' '?' | cut -c1-200)"
commit="$(git rev-parse HEAD 2>/dev/null || git -C "$(cat /etc/box-project 2>/dev/null || echo "$HOME")" rev-parse HEAD 2>/dev/null || echo 0000000)"
mkdir -p ~/.box
printf '%s\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$state" "$commit" "$task" >> ~/.box/status.log
