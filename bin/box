#!/usr/bin/env bash
# box new|reset|retire|destroy|rm|base|ls: the environment for a project, not its workflow.
# new: GitHub repo (empty nix dev shell) plus a sandboxed machine and a herdr workspace; it never starts an agent.
# reset: rebuild the machine from the existing repo, optionally at a commit. retire: remove the machine and the agent's access.
# destroy: retire plus delete the repo. A failed new rolls back the repo and box. base: build box-base and apply box/claude.
# Box layer: box/sandbox new|exec|rm|ls <name>. The box is logged in to gh as the agent account.
# Config: ~/.config/agent-boxes/config sets OWNER (GitHub user owning repos) and AGENT (agent GitHub username).
set -euo pipefail

sandbox="${BOX_SANDBOX:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../box/sandbox}"
config="$HOME/.config/agent-boxes/config"
dry=false

usage() {
  cat <<'EOF'
Usage: box [--dry-run] new NAME
       box [--dry-run] reset NAME [--ref COMMIT]
       box [--dry-run] retire NAME
       box [--dry-run] destroy NAME
       box [--dry-run] rm NAME
       box [--dry-run] base
       box ls

new      create the repo and a box
reset    delete the box and make a fresh one from the existing repo (at --ref if given)
retire   delete the box and remove the agent's access to the repo
destroy  retire, then delete the repo (asks first)
rm       delete the box only; the repo and access stay
base     (re)build box-base and apply box/claude to it

--dry-run prints every command instead of running it.
EOF
}
die() { echo "box: $*" >&2; exit 1; }

# Run a command, or just print it under --dry-run.
run() {
  if $dry; then { printf '+'; printf ' %q' "$@"; echo; } >&2; else "$@"; fi
}
# Run a command whose stdin is a heredoc: print the heredoc too under --dry-run.
run_in() {
  if $dry; then { printf '+'; printf ' %q' "$@"; echo ' <<STDIN'; cat; echo STDIN; } >&2; else "$@"; fi
}

[ "${1:-}" != --dry-run ] || { dry=true; shift; }
cmd="${1:-}"; shift || true

claude_dir="$(dirname "$sandbox")/claude"
case "$cmd" in
  ls) run "$sandbox" ls; exit ;;
  base)
    [ -s "$claude_dir/settings.json" ] || die "missing $claude_dir/settings.json"
    ! grep -rqiE 'ghp_|github_pat_|sk-ant|oauth' "$claude_dir" || die "$claude_dir must not hold tokens"
    run "$sandbox" base
    if $dry; then echo "+ tar -C $claude_dir -cf - . | orb -m box-base <copy into ~/.claude, merging settings.json with jq>" >&2
    else
      orb start box-base
      # settings.json is merged into the base's own; everything else is copied over.
      tar -C "$claude_dir" -cf - . | orb -m box-base bash -lc '
        set -e
        stage="$(mktemp -d)"; tar -C "$stage" -xf -
        mkdir -p ~/.claude; s=~/.claude/settings.json; [ -s "$s" ] || echo "{}" > "$s"
        jq -s ".[0] * .[1]" "$s" "$stage/settings.json" > "$s.tmp" && mv "$s.tmp" "$s"
        rm "$stage/settings.json"; cp -R "$stage/." ~/.claude/; rm -rf "$stage"'
    fi
    while read -r plugin; do
      src="$(jq -r --arg m "${plugin#*@}" '.extraKnownMarketplaces[$m].source | .repo // .url // empty' "$claude_dir/settings.json")"
      [ -n "$src" ] || die "no marketplace source for $plugin in extraKnownMarketplaces"
      # marketplace add fails if it is already there; install below still fails if it is truly missing.
      # </dev/null: orb would otherwise eat the rest of the plugin list from the loop's stdin.
      run orb -m box-base bash -lc 'claude plugin marketplace add "$1" || true; claude plugin install "$2"' _ "$src" "$plugin" </dev/null
    done < <(jq -r '.enabledPlugins // {} | keys[]' "$claude_dir/settings.json")
    $dry || orb stop box-base
    exit ;;
  new | reset | retire | destroy | rm) ;;
  -h | --help | "") usage; exit ;;
  *) usage >&2; die "unknown command: $cmd" ;;
esac

name="${1:?usage: box $cmd NAME}"; shift
[[ "$name" =~ ^[a-z][a-z0-9-]*$ ]] || die "NAME must be lowercase letters, digits, dashes (it is also the ssh user): $name"
ref=""
while [ $# -gt 0 ]; do
  case "$cmd:$1" in
    reset:--ref) ref="${2:?--ref needs a value}"; shift 2 ;;
    *) usage >&2; die "unknown argument: $1" ;;
  esac
done

# Validate everything up front so a bad flag never leaves a half-made box.
[ -r "$config" ] || die "missing $config (set OWNER=<github user> and AGENT=<agent github user>)"
OWNER="" AGENT=""
# shellcheck disable=SC1090
. "$config"
[ -n "$OWNER" ] && [ -n "$AGENT" ] || die "$config must set OWNER and AGENT"
owner="$OWNER" agent="$AGENT"
repo="repos/$owner/$name"
[[ -z "$ref" || "$ref" =~ ^[A-Za-z0-9_][A-Za-z0-9._/-]*$ ]] || die "invalid --ref: $ref"
if ! $dry; then
  for tool in gh git herdr jq; do command -v "$tool" >/dev/null || die "$tool not found"; done
  [ -x "$sandbox" ] || die "box layer not found or not executable: $sandbox"
  [ "$(gh api user --jq .login 2>/dev/null)" = "$owner" ] || die "gh is not logged in as $owner; run: gh auth login"
  if [ "$cmd" = new ]; then
    ! gh repo view "$owner/$name" >/dev/null 2>&1 || die "repo $owner/$name already exists"
    # A failed new removes the box named $name, so never start over an existing one.
    ! "$sandbox" ls | awk -v n="$name" '$1 == n { f=1 } END { exit !f }' || die "box $name already exists"
  elif [ "$cmd" != rm ]; then
    gh repo view "$owner/$name" >/dev/null 2>&1 || die "repo $owner/$name does not exist"
  fi
fi

# The machine may never have been added; still carry on.
machine_remove() {
  local id
  id="$(herdr machine list --json | jq -r --arg l "$name" '[.. | objects | select(.label? == $l) | .id][0] // empty')"
  if [ -n "$id" ]; then run herdr machine remove "$id" || echo "box: herdr machine remove failed, continuing" >&2
  else echo "box: no herdr machine labeled $name, continuing" >&2; fi
}

# Add the delete_repo scope once if gh lacks it; it stays.
delete_repo() {
  if $dry || ! gh auth status 2>&1 | grep -q delete_repo; then run gh auth refresh -s delete_repo; fi
  run gh repo delete "$owner/$name" --yes
}

repo_id=0 # only new knows the id; reset passes accept=0 and never reads it
# Create the box, connect herdr, clone the repo and open its workspace. $1 = accept the collaborator invite (new only).
provision() {
  local accept="$1"
  # Machine add inside this step starts the box herdr server.
  echo "==> Creating box $name"
  run "$sandbox" new "$name"
  # herdr reaches the box over ssh; fail here with a hint rather than inside machine add.
  local ssh_ok=false
  for _ in $(seq 10); do
    run ssh -o BatchMode=yes "$name@orb" true && { ssh_ok=true; break; }
    sleep 1
  done
  $ssh_ok || die "cannot ssh $name@orb non-interactively; add this to ~/.ssh/config:
Host orb
  HostName 127.0.0.1
  Port 32222
  User default
  IdentityFile ~/.orbstack/ssh/id_ed25519
  IdentitiesOnly yes
  ForwardAgent no"
  # Before any pane exists: machine add starts the box's herdr server and may restart it, killing panes.
  # No tty on stdin keeps it non-interactive; a fresh box has herdr installed and no server, so nothing to confirm.
  run herdr machine add "ssh://$name@orb" --label "$name" --remote-session default </dev/null
  # The invite can lag behind the PUT, so retry the accept.
  run_in "$sandbox" exec "$name" bash -s <<EOF
set -euo pipefail
[ -n "\${GH_TOKEN:-}" ] || { echo "box: GH_TOKEN missing in the box" >&2; exit 1; }
if [ "$accept" = 1 ]; then
  # Invitations left by deleted repos of the same name carry other repo ids: decline them, accept only ours.
  for _ in \$(seq 30); do
    invs="\$(gh api user/repository_invitations --paginate)"
    for stale in \$(jq -r '.[] | select(.repository.full_name == "$owner/$name" and .repository.id != $repo_id) | .id' <<<"\$invs"); do
      gh api -X DELETE "user/repository_invitations/\$stale" >/dev/null || true
    done
    id="\$(jq -r '.[] | select(.repository.id == $repo_id) | .id' <<<"\$invs" | head -n1)"
    [ -z "\$id" ] || break
    sleep 2
  done
  [ -n "\$id" ] || { echo "box: no invitation to $owner/$name found" >&2; exit 1; }
  if ! out="\$(gh api -i -X PATCH "user/repository_invitations/\$id" 2>&1)"; then
    echo "box: accepting the invitation failed: \$(head -n1 <<<"\$out")" >&2
    echo "\$out" | awk 'f; /^\r?\$/ { f = 1 }' >&2
    ! grep -qi scope <<<"\$out" || echo "box: agent token needs the repo:invite scope" >&2
    exit 1
  fi
fi
gh repo clone $owner/$name ~/$name
cd ~/$name
if [ "$accept" = 1 ]; then
  # Collaborator access can lag the accept; a dry-run push exercises the same auth as a real one.
  pushed=false
  for _ in \$(seq 15); do
    if err="\$(git push --dry-run origin main 2>&1)"; then pushed=true; break; fi
    sleep 2
  done
  \$pushed || { echo "box: agent cannot push to $owner/$name; last git error:" >&2; echo "\$err" >&2; exit 1; }
fi
[ -z "$ref" ] || git checkout "$ref"
direnv allow ~/$name
# Pre-accept folder trust so the agent never blocks on a dialog.
mkdir -p ~/.claude
[ -s ~/.claude.json ] || echo '{}' > ~/.claude.json
jq --arg p "\$HOME/$name" '.projects[\$p].hasTrustDialogAccepted = true' ~/.claude.json > ~/.claude.json.tmp && mv ~/.claude.json.tmp ~/.claude.json
for _ in \$(seq 30); do herdr workspace list >/dev/null 2>&1 && break; sleep 1; done
herdr workspace create --cwd ~/$name --label $name --no-focus >/dev/null
EOF
}

case "$cmd" in
  rm) machine_remove; run "$sandbox" rm "$name"; exit ;;
  retire)
    machine_remove
    run "$sandbox" rm "$name"
    run gh api -X DELETE "$repo/collaborators/$agent" >/dev/null
    exit ;;
  destroy)
    if ! $dry; then
      read -r -p "Delete box $name AND repo $owner/$name permanently? [y/N] " ans
      [ "$ans" = y ] || exit 0
    fi
    machine_remove
    run "$sandbox" rm "$name" || echo "box: no box $name, continuing" >&2
    run gh api -X DELETE "$repo/collaborators/$agent" >/dev/null || echo "box: agent was not a collaborator, continuing" >&2
    delete_repo
    exit ;;
  reset)
    machine_remove
    run "$sandbox" rm "$name"
    provision 0
    echo "box $name reset${ref:+ at $ref}: github.com/$owner/$name"
    exit ;;
esac

# --- new, 1. Mac side: repo contents ---
dir="$(mktemp -d "${TMPDIR:-/tmp}/box.XXXXXX")"
armed=false
# Once the repo exists, any failure removes the box, the herdr entry and the repo so the name can be rerun.
cleanup() {
  local rc=$?
  trap - EXIT
  if $armed && [ $rc -ne 0 ] && [ "${BOX_KEEP:-}" = 1 ]; then
    echo "box: new failed; $name and $owner/$name kept for debugging" >&2
  elif $armed && [ $rc -ne 0 ]; then
    echo "box: new failed, rolling back $name" >&2
    armed=false
    machine_remove || true
    "$sandbox" rm "$name" || true
    delete_repo || echo "box: could not delete $owner/$name; run: box destroy $name" >&2
  fi
  $dry || rm -rf "$dir"
  exit $rc
}
trap cleanup EXIT
cd "$dir"
git init -q -b main

cat >flake.nix <<'EOF'
{
  description = "dev shell";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-26.05";

  outputs = { self, nixpkgs }:
    let
      forAllSystems = nixpkgs.lib.genAttrs [ "aarch64-linux" "x86_64-linux" ];
    in
    {
      devShells = forAllSystems (system:
        let
          pkgs = nixpkgs.legacyPackages.${system};
        in
        {
          default = pkgs.mkShell {
            packages = [ ];
          };
        });
    };
}
EOF

echo "use flake" >.envrc
printf '.direnv/\nresult\n.worktrees/\n' >.gitignore
command -v nix >/dev/null && nix --extra-experimental-features "nix-command flakes" flake lock 2>/dev/null || true
git add -A
git commit -q -m "Initial commit"

echo "==> Creating GitHub repo $owner/$name"
run gh repo create "$owner/$name" --public --source . --remote origin
armed=true
# Same-name invitations from deleted repos exist, so the box accepts by numeric id.
repo_id=0
$dry || repo_id="$(gh api "$repo" --jq .id)"
push=(git -c credential.helper= -c 'credential.helper=!gh auth git-credential' push -q origin main)
if $dry; then run "${push[@]}"; else
  log="$(mktemp "${TMPDIR:-/tmp}/box-push.XXXXXX")"
  for attempt in 1 2 3; do
    "${push[@]}" 2>"$log" && break
    cat "$log" >&2
    if ! grep -q -E 'Internal Server Error|error: 5[0-9][0-9]|HTTP 5[0-9][0-9]|returned error: 5[0-9][0-9]' "$log" || [ "$attempt" = 3 ]; then
      die "initial push failed"
    fi
    echo "box: GitHub 5xx on push (attempt $attempt/3), retrying in 5s" >&2
    sleep 5
  done
  rm -f "$log"
fi
run gh api -X PATCH "$repo" -F delete_branch_on_merge=true >/dev/null
run_in gh api -X POST "$repo/rulesets" --input - >/dev/null <<'EOF'
{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [{ "actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always" }],
  "conditions": { "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] } },
  "rules": [
    { "type": "non_fast_forward" },
    { "type": "deletion" }
  ]
}
EOF
run gh api -X PUT "$repo/collaborators/$agent" -f permission=push >/dev/null

# --- new, 2. Box side ---
provision 1
armed=false

echo "box $name ready: github.com/$owner/$name"
