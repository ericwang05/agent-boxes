#!/usr/bin/env bash
# sandbox - throwaway OrbStack Debian machines, cloned from one provisioned base.
# A box gets fake tokens only: ANTHROPIC_BASE_URL and one git insteadOf point at localhost:8080, which the bridge carries
# to the Mac-side proxy (proxy/proxy.py) that holds the real tokens. Everything else goes straight out, ports 80/443 only.
set -euo pipefail

BASE=box-base
HERE=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)
CONFIG_FILE="$HOME/.config/agent-boxes/config"
SANDBOX_DISTRO="${SANDBOX_DISTRO:-debian:trixie}"
SANDBOX_USER="${USER:-$(id -un)}"
# Optional BOX_CPUS, BOX_MEMORY_MIB; required GIT_NAME, GIT_EMAIL.
[ ! -r "$CONFIG_FILE" ] || . "$CONFIG_FILE"
BOX_CPUS="${BOX_CPUS:-4}"
BOX_MEMORY_MIB="${BOX_MEMORY_MIB:-8192}"

usage() {
  cat <<'USAGE'
Usage: sandbox <command>
  base                Build (or rebuild) the base machine from setup.sh, and the bridge binaries
  new <name> <owner/repo>  Clone base into a hardened machine with fake tokens, no host mount
  exec <name> '<cmd>' Run a login-shell command in a machine
  rm <name>           Delete a machine
  ls                  List machines
USAGE
}

exists() { orb list 2>/dev/null | awk -v n="$1" '$1 == n { f=1 } END { exit !f }'; }

need_name() {
  case "${1:-}" in
    ''|*/*|.|..|-*) echo "error: invalid machine name '${1:-}'" >&2; exit 1 ;;
    "$BASE") echo "error: '$BASE' is managed by 'sandbox base'" >&2; exit 1 ;;
  esac
}

# The Go bridge: the Mac side runs under launchd, the box side is copied into every box.
build_bridge() {
  mkdir -p "$HERE/../build"
  (cd "$HERE/../bridge" && go build -o ../build/agentbox-bridge . && GOOS=linux GOARCH=arm64 go build -o ../build/agentbox-bridge-linux .)
}

# Root-run steps use `orb -u root`, not sudo: harden removes the sudo grant.
harden() {
  # OrbStack grants passwordless sudo via /etc/sudoers.d/orbstack; empty it so the agent cannot change root-owned files.
  orb -m "$1" -u root bash -c '
    : > /etc/sudoers.d/orbstack
    if runuser -u '"$SANDBOX_USER"' -- sudo -n true 2>/dev/null; then
      echo "FATAL: sudo still works after strip" >&2; exit 1
    fi'
}

# Fail closed: web works; the host, the LAN, other ports and sudo are out; no host files are mounted.
check_isolation() {
  orb -m "$1" curl -fsS -m 15 -o /dev/null https://github.com \
    || { echo "error: '$1' cannot reach https://github.com" >&2; return 1; }
  ! orb -m "$1" curl -m 3 -s -o /dev/null http://host.orb.internal \
    || { echo "error: '$1' can reach the host (host.orb.internal)" >&2; return 1; }
  ! orb -m "$1" curl -m 3 -s -o /dev/null http://192.168.1.1 \
    || { echo "error: '$1' can reach the LAN (192.168.1.1)" >&2; return 1; }
  ! orb -m "$1" bash -c 'timeout 4 bash -c "echo > /dev/tcp/github.com/22"' 2>/dev/null \
    || { echo "error: '$1' can reach github.com port 22" >&2; return 1; }
  ! orb -m "$1" sudo -n true 2>/dev/null \
    || { echo "error: '$1' still has sudo" >&2; return 1; }
  orb -m "$1" bash -c '! mount | grep -qiE "/Users|/mnt/mac" && [ ! -e /mnt/mac ]' \
    || { echo "error: '$1' has host files mounted (/Users or /mnt/mac)" >&2; return 1; }
  echo "isolation ok: web reachable; host, LAN, other ports and sudo blocked; no host mounts"
}

# Root-owned parts: firewall, bridge user and binary, nix-daemon drop-in, Claude managed settings, box-note, project path.
install_root() { # name project
  orb -m "$1" -u root bash -c 'cat > /etc/nftables.conf && chmod 644 /etc/nftables.conf && nft -c -f /etc/nftables.conf && nft -f /etc/nftables.conf && systemctl enable nftables >/dev/null 2>&1' < "$HERE/firewall.nft"
  orb -m "$1" -u root bash -c 'mkdir -p /etc/claude-code && cat > /etc/claude-code/managed-settings.json && chmod 644 /etc/claude-code/managed-settings.json' < "$HERE/managed-settings.json"
  orb -m "$1" -u root bash -c 'cat > /usr/local/bin/box-note && chmod 755 /usr/local/bin/box-note' < "$HERE/box-note"
  orb -m "$1" -u root bash -c 'cat > /usr/local/sbin/agentbox-bridge && chmod 755 /usr/local/sbin/agentbox-bridge' < "$HERE/../build/agentbox-bridge-linux"
  orb -m "$1" -u root bash -s "/home/$SANDBOX_USER/$2" <<'ROOT'
set -euo pipefail
printf '%s\n' "$1" > /etc/box-project
id bridge >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin bridge
mkdir -p /etc/systemd/system/nix-daemon.service.d
printf '[Service]\nEnvironment="AWS_EC2_METADATA_DISABLED=true"\n' > /etc/systemd/system/nix-daemon.service.d/aws.conf
systemctl daemon-reload
systemctl try-restart nix-daemon.service || true
ROOT
}

# The agent's own files: fake tokens, base URL, git routing for its one repo, git identity, Claude first-run answers.
install_user() { # name owner/repo
  orb -m "$1" env GIT_NAME="$GIT_NAME" GIT_EMAIL="$GIT_EMAIL" BOX="$1" REPO="$2" bash -s <<'USER'
set -euo pipefail
git config --global user.name "$GIT_NAME"
git config --global user.email "$GIT_EMAIL"
# Only the box's own repo goes through the proxy; the proxy asks for credentials with a 401, so no global proactiveAuth.
git config --global "url.http://localhost:8080/gh/$REPO.insteadOf" "https://github.com/$REPO"
git config --global "credential.http://localhost:8080.helper" '!f() { echo username=x; echo password=$GH_TOKEN; }; f'
umask 077
printf 'export GH_TOKEN=FAKE-GH-%s CLAUDE_CODE_OAUTH_TOKEN=FAKE-CLAUDE-%s\n' "$BOX" "$BOX" > ~/.box-env
if ! grep -q box-env ~/.bashrc; then
  { echo '[ -f ~/.box-env ] && . ~/.box-env'; cat ~/.bashrc; } > ~/.bashrc.new
  mv ~/.bashrc.new ~/.bashrc
fi
[ -s ~/.claude.json ] || echo '{}' > ~/.claude.json
jq '.hasCompletedOnboarding = true | .hasSeenAutoDefaultNudge = true' ~/.claude.json > ~/.claude.json.tmp && mv ~/.claude.json.tmp ~/.claude.json
USER
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  base)
    build_bridge
    if exists "$BASE"; then
      read -r -p "Rebuild '$BASE' from scratch? [y/N] " ans
      [ "$ans" = y ] || exit 0
      orb delete -f "$BASE"
    fi
    orb create --isolated --isolate-network "$SANDBOX_DISTRO" "$BASE"
    orb -m "$BASE" sudo env SETUP_USER="$SANDBOX_USER" \
      bash -s < "$HERE/setup.sh"
    orb stop "$BASE"
    cat <<STEPS

Base ready. Then: $0 new <name> <owner/repo>
STEPS
    ;;
  new)
    name="${1:-}"; need_name "$name"
    repo="${2:?usage: sandbox new <name> <owner/repo>}"
    exists "$BASE" || { echo "error: no base - run: $0 base" >&2; exit 1; }
    exists "$name" && { echo "error: '$name' already exists" >&2; exit 1; }
    [ -x "$HERE/../build/agentbox-bridge-linux" ] || { echo "error: bridge not built - run: $0 base" >&2; exit 1; }
    [ -n "${GIT_NAME:-}" ] && [ -n "${GIT_EMAIL:-}" ] || { echo "error: set GIT_NAME and GIT_EMAIL in $CONFIG_FILE" >&2; exit 1; }
    trap 'orb delete -f "$name" >/dev/null 2>&1 || true; echo "error: creation failed, cleaned up" >&2' ERR
    orb clone "$BASE" "$name"
    orb config set "machine.$name.cpu" "$BOX_CPUS"
    orb config set "machine.$name.memory_mib" "$BOX_MEMORY_MIB"
    orb config set "machine.$name.isolated" true
    orb config set "machine.$name.isolate_network" true
    # config is read at boot, so restart the clone before testing it
    orb stop "$name" >/dev/null 2>&1 || true
    orb start "$name"
    install_root "$name" "${repo#*/}"
    harden "$name"
    check_isolation "$name"
    install_user "$name" "$repo"
    trap - ERR
    echo "ready: $0 exec $name '<cmd>'"
    ;;
  exec)
    name="${1:-}"; need_name "$name"
    exists "$name" || { echo "error: no machine '$name'" >&2; exit 1; }
    shift; [ $# -gt 0 ] || { usage >&2; exit 1; }
    # "$*" so `exec n 'cmd'` and `exec n bash -s` (stdin passthrough) both work
    exec orb -m "$name" bash -lc "$*"
    ;;
  rm)
    name="${1:-}"; need_name "$name"
    exists "$name" || { echo "error: no machine '$name'" >&2; exit 1; }
    orb delete -f "$name"
    ;;
  ls) orb list ;;
  *) usage ;;
esac
