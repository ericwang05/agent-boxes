#!/usr/bin/env bash
# box new|status|reset|rm|panic|base|ls: the environment for a project, not its workflow.
# new: GitHub repo (empty nix dev shell, locked main) plus a sandboxed machine, a per-box proxy and bridge under launchd,
# and a herdr pane with Claude Code running. The box holds fake tokens only; the proxy on this Mac holds the real ones (Keychain).
# Box layer: box/sandbox. Proxy: proxy/proxy.py. Bridge: bridge/ (Go). Config: ~/.config/agent-boxes/config (OWNER, AGENT).
set -euo pipefail

root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
sandbox="${BOX_SANDBOX:-$root/box/sandbox}"
cfg="${BOX_CONFIG_DIR:-$HOME/.config/agent-boxes}"
config="$cfg/config"
reg_dir="$cfg/box-repos" run_dir="$cfg/run" log_dir="$cfg/logs" status_dir="$cfg/status"
agents_dir="$HOME/Library/LaunchAgents"
uid="$(id -u)"

usage() {
  cat <<'EOF'
Usage: box new NAME [--repo owner/name]
       box status [NAME] [--history]
       box reset NAME --to <commit | pr/N | status/N>
       box rm NAME
       box panic
       box base
       box ls

new      create the repo (or attach with --repo), lock main, make the box, start its proxy and bridge, open the herdr pane
status   one row per box from its status log; --history shows the full timeline (status/N numbers for reset)
reset    delete the box and rebuild it at that commit, PR head or status entry
rm       delete the box and its proxy and bridge; the repo and status history stay
panic    stop every box, bridge and proxy now
base     (re)build box-base, the bridge binaries and apply box/claude
EOF
}
die() { echo "box: $*" >&2; exit 1; }

cmd="${1:-}"; shift || true
claude_dir="$root/box/claude"

# The Mac side of a box: one proxy and one bridge under launchd, one Unix socket between them (folder mode 700).
label() { echo "dev.agent-boxes.$1-$2"; }
write_plist() { # name kind program args...
  local name="$1" kind="$2" f="$agents_dir/dev.agent-boxes.$1-$2.plist"; shift 2
  mkdir -p "$agents_dir" "$log_dir"
  {
    echo '<?xml version="1.0" encoding="UTF-8"?><plist version="1.0"><dict>'
    echo "<key>Label</key><string>$(label "$name" "$kind")</string><key>ProgramArguments</key><array>"
    printf '<string>%s</string>' "$@"
    echo '</array><key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string>'
    echo "<key>BRIDGE_DIR</key><string>$log_dir</string></dict>"
    echo "<key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>1</integer>"
    echo "<key>StandardOutPath</key><string>$log_dir/$name.$kind.log</string><key>StandardErrorPath</key><string>$log_dir/$name.$kind.log</string>"
    echo '</dict></plist>'
  } >"$f"
}
jobs_start() { # name owner/repo
  local name="$1" sock="$run_dir/$1.sock"
  [ -x "$root/build/agentbox-bridge" ] || die "bridge not built; run: box base"
  mkdir -p "$run_dir" "$log_dir" "$status_dir"; chmod 700 "$run_dir"
  jobs_stop "$name"
  write_plist "$name" proxy /usr/bin/python3 -I "$root/proxy/proxy.py" --box "$name" --repo "$2" --sock "$sock"
  launchctl bootstrap "gui/$uid" "$agents_dir/$(label "$name" proxy).plist"
  for _ in $(seq 20); do [ -S "$sock" ] && break; sleep 0.5; done
  [ -S "$sock" ] || die "proxy for $name did not start; see $log_dir/$name.proxy.log"
  write_plist "$name" bridge "$root/build/agentbox-bridge" mac-side -box "$name" -dial "unix:$sock" -max-streams 64 -rate 100 -idle 2m -life 0
  launchctl bootstrap "gui/$uid" "$agents_dir/$(label "$name" bridge).plist"
}
jobs_stop() {
  local k
  for k in bridge proxy; do # bridge first, or it restart-loops against a dead socket
    launchctl bootout "gui/$uid/$(label "$1" $k)" 2>/dev/null || true
    rm -f "$agents_dir/$(label "$1" $k).plist"
  done
  rm -f "$run_dir/$1.sock"
}

case "$cmd" in
  ls) "$sandbox" ls; exit ;;
  panic)
    for f in "$agents_dir"/dev.agent-boxes.*.plist; do
      [ -e "$f" ] || continue
      launchctl bootout "gui/$uid/$(basename "$f" .plist)" 2>/dev/null || true
      rm -f "$f"
    done
    rm -f "$run_dir"/*.sock
    # herdr reconnects over ssh and would wake a stopped box, so disable its machine first.
    while read -r m; do
      id="$(herdr machine list --json | jq -r --arg l "$m" '[.. | objects | select(.label? == $l) | .id][0] // empty')"
      [ -z "$id" ] || herdr machine disable "$id" </dev/null || true
      orb stop "$m" </dev/null || true
    done < <(orb list | awk '$2 == "running" && $1 != "box-base" { print $1 }')
    echo "Every box, bridge and proxy is stopped. Bring a box back with: box reset NAME --to <commit>"
    exit ;;
  base)
    [ -s "$claude_dir/settings.json" ] || die "missing $claude_dir/settings.json"
    ! grep -rqiE 'ghp_|github_pat_|sk-ant|oauth' "$claude_dir" || die "$claude_dir must not hold tokens"
    "$sandbox" base
    orb start box-base
    # settings.json is merged into the base's own; everything else is copied over.
    tar -C "$claude_dir" -cf - . | orb -m box-base bash -lc '
      set -e
      stage="$(mktemp -d)"; tar -C "$stage" -xf -
      mkdir -p ~/.claude; s=~/.claude/settings.json; [ -s "$s" ] || echo "{}" > "$s"
      jq -s ".[0] * .[1]" "$s" "$stage/settings.json" > "$s.tmp" && mv "$s.tmp" "$s"
      rm "$stage/settings.json"; cp -R "$stage/." ~/.claude/; rm -rf "$stage"'
    while read -r plugin; do
      src="$(jq -r --arg m "${plugin#*@}" '.extraKnownMarketplaces[$m].source | .repo // .url // empty' "$claude_dir/settings.json")"
      [ -n "$src" ] || die "no marketplace source for $plugin in extraKnownMarketplaces"
      # marketplace add fails if it is already there; install still fails if it is truly missing.
      # </dev/null: orb would otherwise eat the rest of the plugin list from the loop's stdin.
      orb -m box-base bash -lc 'claude plugin marketplace add "$1" || true; claude plugin install "$2"' _ "$src" "$plugin" </dev/null
    done < <(jq -r '.enabledPlugins // {} | keys[]' "$claude_dir/settings.json")
    orb stop box-base
    exit ;;
  new | reset | rm | status) ;;
  -h | --help | "") usage; exit ;;
  *) usage >&2; die "unknown command: $cmd" ;;
esac

# --- status: pull each box's status log into the append-only Mac copy, then show it ---
# The box can write anything, so each line is checked: time, state, commit (hex) and a short safe task; the rest is dropped.
valid_status='BEGIN { FS = "\t" } NF == 4 && $1 ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z$/ && $2 ~ /^(working|done|needs-you|blocked)$/ && $3 ~ /^[0-9a-f]{7,40}$/ && length($4) <= 200 && $4 ~ /^[A-Za-z0-9 ._,:;\/#@()+=?-]*$/'
pull_status() { # name
  local f="$status_dir/$1.log" line
  mkdir -p "$status_dir"; touch "$f"
  orb -m "$1" bash -c 'cat ~/.box/status.log 2>/dev/null || true' 2>/dev/null </dev/null | awk "$valid_status" | while IFS= read -r line; do
    grep -qxF -- "$line" "$f" || printf '%s\n' "$line" >>"$f"
  done
}
if [ "$cmd" = status ]; then
  want="" hist=false
  for a in "$@"; do case "$a" in --history) hist=true ;; -*) die "unknown argument: $a" ;; *) want="$a" ;; esac; done
  names=$(cd "$reg_dir" 2>/dev/null && ls | sed 's/\.json$//' || true)
  [ -z "$want" ] || names="$want"
  for n in $names; do
    orb list 2>/dev/null | awk -v n="$n" '$1 == n && $2 == "running" { f=1 } END { exit !f }' && pull_status "$n" || true
    f="$status_dir/$n.log"
    [ -s "$f" ] || { printf '%-12s %s\n' "$n" "no status yet"; continue; }
    if $hist; then echo "== $n"; awk -F'\t' '{ printf "%3d  %s  %-9s %s  %s\n", NR, $1, $2, substr($3, 1, 7), $4 }' "$f"; continue; fi
    repo="$(jq -r '.repo // empty' "$reg_dir/$n.json" 2>/dev/null || true)"
    IFS=$'\t' read -r t s c k < <(tail -n 1 "$f")
    pr=""; [ -z "$repo" ] || pr="$(gh api "repos/$repo/commits/$c/pulls" --jq '.[0].html_url // empty' 2>/dev/null || true)"
    printf '%-12s %-9s %-40.40s %s  %s  %s\n' "$n" "$s" "$k" "${c:0:7}" "$t" "$pr"
  done
  exit
fi

name="${1:?usage: box $cmd NAME}"; shift
[[ "$name" =~ ^[a-z][a-z0-9-]*$ ]] || die "NAME must be lowercase letters, digits, dashes (it is also the ssh user): $name"
attach="" to=""
while [ $# -gt 0 ]; do
  case "$cmd:$1" in
    new:--repo) attach="${2:?--repo needs owner/name}"; shift 2 ;;
    reset:--to) to="${2:?--to needs a value}"; shift 2 ;;
    *) usage >&2; die "unknown argument: $1" ;;
  esac
done

[ -r "$config" ] || die "missing $config (set OWNER=<github user> and AGENT=<agent github user>)"
OWNER="" AGENT=""
# shellcheck disable=SC1090
. "$config"
[ -n "$OWNER" ] && [ -n "$AGENT" ] || die "$config must set OWNER and AGENT"
rowner="$OWNER" rname="$name" attached=false
if [ -n "$attach" ]; then
  [[ "$attach" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "invalid --repo (want owner/name): $attach"
  [ "${attach%%/*}" = "$OWNER" ] || die "--repo must belong to $OWNER: $attach"
  rowner="${attach%%/*}" rname="${attach#*/}" attached=true
elif [ "$cmd" != new ] && [ -e "$reg_dir/$name.json" ]; then
  r="$(jq -r '.repo // empty' "$reg_dir/$name.json")"; [ -z "$r" ] || { rowner="${r%%/*}" rname="${r#*/}"; }
  [ "$(jq -r '.attached // false' "$reg_dir/$name.json")" != true ] || attached=true
fi
repo="$rowner/$rname"
for tool in gh git herdr jq go; do command -v "$tool" >/dev/null || die "$tool not found"; done
[ -x "$sandbox" ] || die "box layer not found or not executable: $sandbox"
[ "$(gh api user --jq .login 2>/dev/null)" = "$OWNER" ] || die "gh is not logged in as $OWNER; run: gh auth login"
for k in agentbox-claude agentbox-github; do security find-generic-password -s "$k" >/dev/null 2>&1 || die "Keychain has no '$k' entry"; done
if [ "$cmd" = new ]; then
  [ -n "$attach" ] || ! gh repo view "$repo" >/dev/null 2>&1 || die "repo $repo already exists"
  # A failed new removes the box named $name, so never start over an existing one.
  ! "$sandbox" ls | awk -v n="$name" '$1 == n { f=1 } END { exit !f }' || die "box $name already exists"
fi
if [ "$cmd" != rm ] && { [ "$cmd" != new ] || [ -n "$attach" ]; }; then
  gh repo view "$repo" >/dev/null 2>&1 || die "repo $repo does not exist"
fi

# The machine may never have been added; still carry on.
machine_remove() {
  local id
  id="$(herdr machine list --json | jq -r --arg l "$name" '[.. | objects | select(.label? == $l) | .id][0] // empty')"
  if [ -n "$id" ]; then herdr machine remove "$id" || echo "box: herdr machine remove failed, continuing" >&2
  else echo "box: no herdr machine labeled $name, continuing" >&2; fi
}
delete_repo() {
  gh auth status 2>&1 | grep -q delete_repo || gh auth refresh -s delete_repo
  gh repo delete "$repo" --yes
}

# Create the box, connect herdr, clone the repo, open the pane. $1 = commit to check out, $2 = first line for the pane (optional).
provision() {
  local ref="$1" note="${2:-}"
  echo "==> Starting the proxy and bridge for $name"
  jobs_start "$name" "$repo"
  echo "==> Creating box $name"
  "$sandbox" new "$name" "$repo"
  # herdr reaches the box over ssh; fail here with a hint rather than inside machine add.
  local ssh_ok=false
  for _ in $(seq 10); do
    ssh -o BatchMode=yes "$name@orb" true && { ssh_ok=true; break; }
    sleep 1
  done
  $ssh_ok || die "cannot ssh $name@orb non-interactively; add this to ~/.ssh/config:
Host orb
  HostName 127.0.0.1
  Port 32222
  User default
  IdentityFile ~/.orbstack/ssh/id_ed25519
  IdentitiesOnly yes
  ForwardAgent no"
  # Before any pane exists: machine add starts the box's herdr server and may restart it, killing panes.
  herdr machine add "ssh://$name@orb" --label "$name" --remote-session default </dev/null
  # The clone goes through the proxy; a repo created seconds ago may lag, so retry. A dry-run push proves write access.
  "$sandbox" exec "$name" bash -s <<EOF
set -euo pipefail
bridge=false
for _ in \$(seq 30); do curl -s -m 3 -o /dev/null http://localhost:8080/__health && { bridge=true; break; }; sleep 1; done
\$bridge || { echo "box: the bridge to the Mac proxy is not up" >&2; exit 1; }
cloned=false
for _ in \$(seq 15); do git clone -q https://github.com/$repo ~/$rname 2>/dev/null && { cloned=true; break; }; sleep 2; done
\$cloned || { echo "box: cannot clone $repo through the proxy" >&2; exit 1; }
cd ~/$rname
pushed=false
for _ in \$(seq 15); do
  if err="\$(git push --dry-run origin HEAD:refs/heads/box-access-check 2>&1)"; then pushed=true; break; fi
  sleep 2
done
\$pushed || { echo "box: the agent cannot push to $repo; last git error:" >&2; echo "\$err" >&2; exit 1; }
[ -z "$ref" ] || git checkout -q "$ref"
[ ! -e .envrc ] || direnv allow .
# Pre-accept folder trust so the agent never blocks on a dialog.
jq --arg p "\$HOME/$rname" '.projects[\$p].hasTrustDialogAccepted = true' ~/.claude.json > ~/.claude.json.tmp && mv ~/.claude.json.tmp ~/.claude.json
for _ in \$(seq 30); do herdr workspace list >/dev/null 2>&1 && break; sleep 1; done
ws="\$(herdr workspace create --cwd ~/$rname --label $name --no-focus)"
pane="\$(jq -r '[.. | objects | .pane_id? // empty][0] // empty' <<<"\$ws")"
[ -n "\$pane" ] || { echo "box: no pane id in: \$ws" >&2; exit 1; }
${note:+herdr pane run "\$pane" "echo '$note'" >/dev/null}
herdr pane run "\$pane" claude >/dev/null
EOF
}

case "$cmd" in
  rm)
    machine_remove; jobs_stop "$name"; "$sandbox" rm "$name"
    echo "box $name removed; the repo $repo and its status history are kept"
    exit ;;
  reset)
    [ -n "$to" ] || die "reset needs --to <commit | pr/N | status/N>"
    case "$to" in
      pr/[0-9]*) sha="$(gh api "repos/$repo/pulls/${to#pr/}" --jq .head.sha)" ;;
      status/[0-9]*) sha="$(sed -n "${to#status/}p" "$status_dir/$name.log" | cut -f3)" ;;
      *) [[ "$to" =~ ^[0-9a-f]{7,40}$ ]] || die "--to must be a commit, pr/N or status/N: $to"; sha="$to" ;;
    esac
    [ -n "${sha:-}" ] || die "nothing found for --to $to"
    sha="$(gh api "repos/$repo/commits/$sha" --jq .sha)" || die "commit $sha is not in $repo"
    entry="$(awk -F'\t' -v c="$sha" 'index(c, $3) == 1 { l = $1 "  " $2 "  " $4 } END { print l }' "$status_dir/$name.log" 2>/dev/null || true)"
    [ -z "$entry" ] || echo "Status entry at that commit: $entry"
    machine_remove; jobs_stop "$name"; "$sandbox" rm "$name" || echo "box: no box $name, continuing" >&2
    provision "$sha" "Reset to ${sha:0:7}.${entry:+ Last status there: $entry}"
    echo "box $name reset at ${sha:0:7}: github.com/$repo"
    exit ;;
esac

# --- new ---
dir="" armed=false
cleanup() {
  local rc=$?
  trap - EXIT
  if $armed && [ $rc -ne 0 ] && [ "${BOX_KEEP:-}" = 1 ]; then
    echo "box: new failed; $name kept for debugging" >&2
  elif $armed && [ $rc -ne 0 ]; then
    echo "box: new failed, rolling back $name" >&2
    machine_remove || true; jobs_stop "$name"; "$sandbox" rm "$name" || true
    ! $attached || echo "box: the repo $repo is untouched" >&2
    rm -f "$reg_dir/$name.json"
    $attached || delete_repo || echo "box: could not delete $repo; delete it by hand" >&2
  fi
  [ -z "$dir" ] || rm -rf "$dir"
  exit $rc
}
trap cleanup EXIT

if ! $attached; then
  dir="$(mktemp -d "${TMPDIR:-/tmp}/box.XXXXXX")"
  cd "$dir"
  git init -q -b main
  cat >flake.nix <<'EOF'
{
  description = "dev shell";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-26.05";

  outputs = { self, nixpkgs }:
    let
      forAllSystems = nixpkgs.lib.genAttrs [ "aarch64-linux" "x86_64-linux" ];
    in
    {
      devShells = forAllSystems (system:
        let
          pkgs = nixpkgs.legacyPackages.${system};
        in
        {
          default = pkgs.mkShell {
            packages = [ ];
          };
        });
    };
}
EOF
  echo "use flake" >.envrc
  printf '.direnv/\nresult\n.worktrees/\n' >.gitignore
  command -v nix >/dev/null && nix --extra-experimental-features "nix-command flakes" flake lock 2>/dev/null || true
  git add -A
  git commit -q -m "Initial commit"

  echo "==> Creating GitHub repo $repo"
  gh repo create "$repo" --public --source . --remote origin
  armed=true
  repo_id="$(gh api "repos/$repo" --jq .id)"
  push=(git -c credential.helper= -c 'credential.helper=!gh auth git-credential' push -q origin main)
  log="$(mktemp "${TMPDIR:-/tmp}/box-push.XXXXXX")"
  for attempt in 1 2 3; do
    "${push[@]}" 2>"$log" && break
    cat "$log" >&2
    if ! grep -q -E 'Internal Server Error|error: 5[0-9][0-9]|HTTP 5[0-9][0-9]|returned error: 5[0-9][0-9]' "$log" || [ "$attempt" = 3 ]; then
      die "initial push failed"
    fi
    echo "box: GitHub 5xx on push (attempt $attempt/3), retrying in 5s" >&2
    sleep 5
  done
  rm -f "$log"
  gh api -X PATCH "repos/$repo" -F delete_branch_on_merge=true >/dev/null
  # No bypass: only a reviewer other than the bot can merge, so only the owner merges.
  gh api -X POST "repos/$repo/rulesets" --input - >/dev/null <<'EOF'
{
  "name": "protect-main",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": { "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] } },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false
      }
    },
    { "type": "non_fast_forward" },
    { "type": "deletion" }
  ]
}
EOF
  gh api -X PATCH "repos/$repo" --input - >/dev/null <<'EOF'
{ "security_and_analysis": { "secret_scanning": { "status": "enabled" }, "secret_scanning_push_protection": { "status": "enabled" } } }
EOF
  # Invite the bot and accept on this Mac with its Keychain token, so the box never needs a real GitHub token.
  gh api -X PUT "repos/$repo/collaborators/$AGENT" -f permission=push >/dev/null
  tok="$(security find-generic-password -s agentbox-github -w | tr -d '[:space:]')"
  [[ ! "$tok" =~ ^([0-9a-f]{2})+$ ]] || tok="$(xxd -r -p <<<"$tok")"
  accepted=false
  for _ in $(seq 30); do
    id="$(GH_TOKEN="$tok" gh api user/repository_invitations --jq ".[] | select(.repository.id == $repo_id) | .id" | head -n1)"
    [ -z "$id" ] || { GH_TOKEN="$tok" gh api -X PATCH "user/repository_invitations/$id" >/dev/null && accepted=true; break; }
    sleep 2
  done
  unset tok
  $accepted || die "the bot $AGENT never saw the invitation to $repo"
  cd "$root"
fi
armed=true
mkdir -p "$reg_dir"
jq -nc --arg p "$repo" --argjson a "$attached" '{repo: $p, attached: $a}' >"$reg_dir/$name.json"

provision ""
echo "box $name ready: github.com/$repo (type the first task in the herdr pane)"
